<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 查询其他应用信息 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".ClipGuardApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_manage"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ClipGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 剪贴板守护前台服务 -->
        <service
            android:name=".service.ClipboardGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Shizuku UserService — 让 Shizuku Manager 识别本应用 -->
        <service
            android:name=".shizuku.PermissionUserService"
            android:exported="true"
            android:permission="moe.shizuku.manager.permission.API_V23">
            <intent-filter>
                <action android:name="moe.shizuku.manager.action.BIND_USER_SERVICE" />
            </intent-filter>
        </service>

        <!-- 开机自启广播 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>